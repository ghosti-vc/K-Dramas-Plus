
{
  "id": "k-dramas-plus",
  "name": "K Dramas Plus",
  "version": "0.1.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "icon": "icon.png",
  "hosts": [
    "doramaexpress.com",
    "image.tmdb.org",
    "morencius.com",
    "bysevepoin.com",
    "vixeo.io",
    "ok.ru",
    "player.abyssplayer.com",
    "dsvplay.com",
    "luluvido.com"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "browser": true,
  "capabilities": ["search", "home", "episodes", "browse", "resolve", "download"],
  "settings": [
    {
      "key": "lang",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "type": "select",
      "hint": "Qué servidores se usan al reproducir",
      "hintEn": "Which servers are used for playback",
      "default": "latino",
      "options": [
        { "value": "latino", "label": "Latino", "labelEn": "Latin Spanish dub" },
        { "value": "sub", "label": "Subtitulado", "labelEn": "Subtitled" },
        { "value": "todos", "label": "Todos", "labelEn": "Both" }
      ]
    }
  ],
  "description": "Doramas y películas en español latino y subtitulado, de Dorama Express: K-dramas, C-dramas y más, con varios servidores por capítulo."
}
